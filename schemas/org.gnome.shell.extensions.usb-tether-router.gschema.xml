<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.usb-tether-router.panel-box">
    <value nick="left" value="0"/>
    <value nick="center" value="1"/>
    <value nick="right" value="2"/>
  </enum>

  <schema id="org.gnome.shell.extensions.usb-tether-router"
          path="/org/gnome/shell/extensions/usb-tether-router/">
    <key name="sites" type="as">
      <default>[]</default>
      <summary>Sites routed through the phone</summary>
      <description>Domains whose traffic goes through the phone in “Only listed sites” mode.</description>
    </key>

    <key name="open-menu-on-connect" type="b">
      <default>true</default>
      <summary>Open the menu when the phone is connected</summary>
      <description>Opens the menu as soon as the phone is plugged in, as a reminder to choose a mode.</description>
    </key>

    <key name="panel-position" enum="org.gnome.shell.extensions.usb-tether-router.panel-box">
      <default>'right'</default>
      <summary>Top bar area</summary>
    </key>

    <key name="panel-index" type="i">
      <default>0</default>
      <range min="0" max="20"/>
      <summary>Position within the area</summary>
      <description>0 = at the start of the chosen area.</description>
    </key>
  </schema>
</schemalist>
